const milestones = [
  {
    title: 'North Star',
    description: 'Embed AI across Lattice with an always-available Assistant, rethink navigation and information architecture, and modernize the visual system.',
    // The walkthrough runs 43s; it plays through once before moving on.
    duration: 43000,
  },
  {
    title: 'Milestones 1 & 2',
    description: 'Move Lattice search into a new top bar on Home. Combine search and Ask Lattice into a single, unified top bar experience.',
    // The video runs 11.7s; this leaves a few seconds after it to finish reading.
    duration: 15000,
  },
  {
    title: 'Milestone 2 fast follows',
    description: 'Introduce chat history and threaded conversations. Surface user-friendly tool calls to indicate thinking progress to user.',
    duration: 10000,
  },
  {
    title: 'Milestone 3',
    description: 'Expand Search & Ask Lattice to all product pages and ensure responsive behavior across break points. Add contextual greetings and AI suggestions to reduce cold starts.',
    duration: 10000,
  },
