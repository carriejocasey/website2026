---
/** A numbered story section: "01 / the context" on the left, the copy on the right. */
interface Props {
  number: string;
  title: string;
}

const { number, title } = Astro.props;
---

<section class="section">
  <h2 class="section__head">
    <span class="section__num">{number}</span>
    <span class="section__title">{title}</span>
  </h2>
  <div class="section__body"><slot /></div>
</section>

<style>
  .section {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    padding: 0 16px;
  }
  .section__head {
    flex: 0 0 224px;
    display: flex;
    flex-direction: column;
    margin: 0;
    font-weight: 400;
    line-height: normal;
  }
  .section__num { font-family: var(--mono); font-size: 18px; color: var(--cs-text-soft); }
  .section__title { font-family: var(--serif); font-size: 40px; }
  .section__body {
    flex: 0 1 640px;
    font-size: 20px;
    line-height: 1.5;
  }
  .section__body :global(p) { margin: 0; }
  .section__body :global(p + p) { margin-top: 1em; }

  @media (max-width: 860px) {
    .section { flex-direction: column; gap: 16px; padding: 0 4px; }
    .section__head { flex: none; }
    .section__title { font-size: 34px; }
    .section__body { flex: none; font-size: 18px; }
  }
</style>
