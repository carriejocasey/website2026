---
/** /work and /play: a list of everything in that collection. Placeholder design. */
import { getCollection } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import { site, type SectionKey } from '~/data/site';

export function getStaticPaths() {
  return (Object.keys(site.sections) as SectionKey[]).map((section) => ({ params: { section } }));
}

const section = Astro.params.section as SectionKey;
const copy = site.sections[section];
const items = (await getCollection(section, ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<PageLayout title={copy.title}>
  <p class="eyebrow">{copy.eyebrow}</p>
  <h1 class:list={['title', { 'title--italic': section === 'play' }]} style={`view-transition-name: ${section}-title`}>
    {copy.title}
  </h1>

  <ul class="list">
    {items.map((item) => (
      <li>
        <a class="row" href={`/${section}/${item.id}`}>
          <span>{item.data.title.toUpperCase()}</span>
          <span class="slash">/</span>
          <em>{item.data.tag}</em>
          {item.data.draft && <span class="draft">draft</span>}
        </a>
      </li>
    ))}
  </ul>
</PageLayout>

<style>
  .eyebrow { margin: 0; font-size: clamp(14px, 1.4vw, 18px); }
  .title {
    margin: 0.1em 0 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(56px, 6.25vw, 96px);
    line-height: 1.05;
    width: fit-content;
  }
  .title--italic { font-style: italic; }

  .list { list-style: none; margin: clamp(40px, 8vh, 80px) 0 0; padding: 0; max-width: 640px; }
  .list li { border-top: 1px solid var(--grid-line); }
  .list li:last-child { border-bottom: 1px solid var(--grid-line); }
  .row {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    padding: 18px 8px;
    font-size: clamp(14px, 1.4vw, 18px);
    transition: padding 0.4s var(--ease-text), background-color 0.3s linear;
  }
  .row em { font-size: 1.1em; }
  .row:hover { padding-left: 16px; background-color: rgba(255, 255, 255, 0.6); }
  .draft { margin-left: auto; color: var(--ink-soft); font-size: 0.8em; }
</style>
