---
/**
 * The home page: one non-scrolling stage with five states.
 *
 *   default  split: grid paper left, sky right            (Figma 4:6)
 *   work     the paper shrinks into a card over the sky    (Figma 4:44)
 *   play     the sky shrinks into a card over the paper    (Figma 4:34)
 *
 * Work and play are mirror images: hovering a half shrinks *that half* into a card, and the
 * other material is already waiting behind it. Nothing grows in from the other side.
 *   about    "carrie noonan*" glass card                   (Figma 7:314)
 *   role     "*designer, maker" glass card                 (Figma 7:361)
 *
 * The current state lives on <main data-state>. Everything visual is CSS keyed off that
 * attribute; scripts/home/controller.ts only decides *which* state is current.
 *
 * All the geometry for every state is in the <style> block below, as custom properties,
 * so the shapes, the text positions and the hover zones can't drift apart.
 */
import { getCollection } from 'astro:content';
import { site } from '~/data/site';
import SkyPhoto from './SkyPhoto.astro';
import Section from './Section.astro';
import HeaderCard from './HeaderCard.astro';

const visible = ({ data }: { data: { draft: boolean; home: boolean } }) =>
  data.home && (import.meta.env.DEV || !data.draft);
const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;

const work = (await getCollection('work', visible)).sort(byOrder);
const play = (await getCollection('play', visible)).sort(byOrder);
---

<main class="stage" id="stage" data-stage data-state="default" data-intro="pending">
  <h1 class="visually-hidden">{site.name}, {site.role.label.replace('*', '')}</h1>

  <div class="paper grid" aria-hidden="true"></div>
  <SkyPhoto />
  <div class="sheet window" aria-hidden="true"><div class="window__frame grid"></div></div>

  <!-- Invisible boxes marking where each open card ends up. The controller keeps a state
       open while the pointer is inside its zone, so text that moves never slips out from
       under the cursor. -->
  <div class="zone zone--work" data-zone="work" aria-hidden="true"></div>
  <div class="zone zone--play" data-zone="play" aria-hidden="true"></div>

  <HeaderCard key="about" label={site.about.label} lines={site.about.lines} />
  <HeaderCard key="role" label={site.role.label} lines={site.role.lines} align="end" />

  <Section key="work" items={work} />
  <Section key="play" items={play} />
</main>

<script>
  import { initHome } from '~/scripts/home/controller';
  initHome();
</script>

<style is:global>
  /* ------------------------------------------------------------------
     Geometry: landscape (Figma frame 1280 x 832)
     ------------------------------------------------------------------ */
  .stage {
    /* type */
    --fs-label: calc(var(--u) * 18);
    --fs-accent: calc(var(--u) * 20);
    --fs-title: calc(var(--u) * 72);   /* the serif runs wider than the Figma one; 72 keeps "work samples" clear of the sky card */
    --head-h: calc(var(--u) * 144);

    /* grid paper */
    --grid: calc(var(--u) * 40);
    --sheet-zoom: 1.2;                                       /* 40px grid -> 48px grid on the work card */
    --sheet-grid-shift: calc(var(--u) * -16) calc(var(--u) * -24);   /* keeps the zoom centered on (80, 120), so card edges land on grid lines */

    /* open cards */
    --card-top: calc(var(--u) * 120);
    --card-edge: calc(var(--u) * 32);
    --card-split: calc(var(--u) * 128);                      /* how far a card reaches past the middle */
    --card-r: calc(var(--u) * 32);
    --work-t: var(--card-top); --work-r: calc(50% - var(--card-split)); --work-b: var(--card-edge); --work-l: var(--card-edge);
    --play-t: var(--card-top); --play-r: var(--card-edge); --play-b: var(--card-edge); --play-l: calc(50% - var(--card-split));

    /* section headings at rest: work from the left edge, play from the right edge */
    --work-x: calc(var(--u) * 48);
    --work-y: calc(var(--u) * 48);
    --play-x: calc(var(--u) * 48);
    --play-y: calc(var(--u) * 48);

    /* header cards */
    --hcard-top: calc(var(--u) * 16);
    --hcard-side: calc(var(--u) * 15);
    --hcard-pad: calc(var(--u) * 32 + 1px);        /* + the glass border, so labels land 48 from each edge */
    --about-color: var(--ink);
    --role-color: var(--on-photo);
    --opposite-label: 1;           /* opacity of the other header label while a card is open */

    /* shapes, per state: each window's top, right, bottom and left edges and its corner radius */
    --photo-t: 0px; --photo-r: 0px; --photo-b: 0px; --photo-l: 50%; --photo-rad: 0px;
    --sheet-t: 0px; --sheet-r: 50%; --sheet-b: 0px; --sheet-l: 0px; --sheet-rad: 0px;
    --sheet-grid: var(--grid);
    --sheet-pos: 0 0;

    /* motion: closing timing by default; open states switch to opening timing */
    --dur: var(--dur-close);
    --ease: var(--ease-close);

    /* The sky's window normally animates with everything else. See "Sky behind the paper" below. */
    --photo-dur: var(--dur);
    --photo-delay: 0s;

    /* A header label changes color the moment a card edge passes over it. These delays are
       measured against --ease-open / --ease-close; both edges cross the labels halfway. */
    --flip-open: 0.16s;
    --flip-close: 0.13s;
    --flip: var(--flip-close);
  }

  .stage[data-state="work"] {
    --dur: var(--dur-open);
    --ease: var(--ease-open);
    --flip: var(--flip-open);
    --photo-t: 0px; --photo-r: 0px; --photo-b: 0px; --photo-l: 0px; --photo-rad: 0px;
    --sheet-t: var(--work-t); --sheet-r: var(--work-r); --sheet-b: var(--work-b); --sheet-l: var(--work-l); --sheet-rad: var(--card-r);
    --sheet-grid: calc(var(--grid) * var(--sheet-zoom));
    --sheet-pos: var(--sheet-grid-shift);
    --about-color: var(--on-photo);
    --role-color: var(--on-photo);
  }
  .stage[data-state="work"] .section--work { --sx: calc(var(--u) * 32); --sy: calc(var(--u) * -32); }

  .stage[data-state="play"] {
    --dur: var(--dur-open);
    --ease: var(--ease-open);
    --flip: var(--flip-open);
    --photo-t: var(--play-t); --photo-r: var(--play-r); --photo-b: var(--play-b); --photo-l: var(--play-l); --photo-rad: var(--card-r);
    --photo-nudge: calc(var(--u) * -36) calc(var(--u) * 20);
    /* The sheet tucks away under the paper edge so it never overlaps the sky card. */
    --sheet-t: 0px; --sheet-r: calc(50% + var(--card-split)); --sheet-b: 0px; --sheet-l: 0px; --sheet-rad: 0px;
    --role-color: var(--ink);
  }
  .stage[data-state="play"] .section--play { --sx: calc(var(--u) * -32); --sy: calc(var(--u) * -32); }

  /* Sky behind the paper. While work is open the sky has to fill the whole stage, but it
     should never be seen *growing* there: it's meant to have been behind the paper all along.
     So the sky's window jumps to full bleed while the paper still covers the left half, and on
     the way back it waits until the paper has fully closed before jumping back. Going between
     work and play, the sky really does change shape, so that animates as usual.
     Both tricks only apply while the sky is at rest. If it's still moving (data-sky="moving",
     set by the controller), jumping or freezing it mid-flight looks like a glitch, so it just
     carries on animating to wherever it's needed now. data-sky="holding" means a hold from a
     moment ago hasn't fired yet; it keeps holding until it does. */
  .stage[data-state="work"]:not([data-prev="play"], [data-sky="moving"]) { --photo-dur: 0s; }
  .stage:is([data-state="default"], [data-state="about"], [data-state="role"]):is([data-prev="work"]:not([data-sky="moving"]), [data-sky="holding"]) {
    --photo-dur: 0s;
    --photo-delay: var(--dur-close);
  }

  /* ------------------------------------------------------------------
     Geometry: portrait (phones, tall tablets). No Figma frame yet; this
     stacks the same idea vertically: paper on top, sky below.
     ------------------------------------------------------------------ */
  @media (max-aspect-ratio: 4/5) {
    .stage {
      --fs-label: calc(var(--u) * 14);
      --fs-accent: calc(var(--u) * 15.5);
      --fs-title: calc(var(--u) * 52);
      --head-h: calc(var(--u) * 92);

      --sheet-grid-shift: calc(var(--u) * -32) calc(var(--u) * -8);  /* zoom centered on (160, 40) */

      --card-top: calc(var(--u) * 88);
      --card-edge: calc(var(--u) * 16);
      --card-split: calc(var(--u) * 96);
      --card-r: calc(var(--u) * 24);
      --work-t: var(--card-top); --work-r: var(--card-edge); --work-b: calc(50% - var(--card-split)); --work-l: var(--card-edge);
      --play-t: calc(50% - var(--card-split)); --play-r: var(--card-edge); --play-b: var(--card-edge); --play-l: var(--card-edge);

      --work-x: calc(var(--u) * 24);
      --work-y: calc(50% + var(--u) * 24);
      --play-x: calc(var(--u) * 24);
      --play-y: calc(var(--u) * 24);

      --hcard-top: calc(var(--u) * 8);
      --hcard-side: calc(var(--u) * 8);
      --hcard-pad: calc(var(--u) * 16 + 1px);
      --role-color: var(--ink);
      --opposite-label: 0;           /* both labels share one row, so an open card hides the other */

      --photo-t: 50%; --photo-r: 0px; --photo-b: 0px; --photo-l: 0px; --photo-rad: 0px;
      --sheet-t: 0px; --sheet-r: 0px; --sheet-b: 50%; --sheet-l: 0px; --sheet-rad: 0px;

      /* the paper card's top edge crosses the labels a third of the way in (and out) */
      --flip-open: 0.13s;
      --flip-close: 0.17s;
    }
    .stage[data-state="work"] .section--work { --sx: calc(var(--u) * 16); --sy: calc(var(--u) * 96); }

    .stage[data-state="play"] {
      --photo-nudge: 0 0;
      --sheet-t: 0px; --sheet-r: 0px; --sheet-b: calc(50% + var(--card-split)); --sheet-l: 0px; --sheet-rad: 0px;
    }
    .stage[data-state="play"] .section--play { --sx: calc(var(--u) * -16); --sy: calc(var(--u) * -16); }
    .stage[data-state="play"] .section--work { --sy: calc(var(--u) * -96); }
  }

  /* ------------------------------------------------------------------
     Card windows. The paper card and the sky are each a plain box with
     rounded corners (.window) whose edges move, and inside it a stage-sized
     frame (.window__frame) shifted back by the same amount, so the grid or
     photo holds still while the window opens and closes around it.
     Earlier versions cut the shapes with an animated clip-path. Chrome
     sometimes drew that clip square, or left a stale strip of the old
     shape behind, once something nearby put the card on its own layer
     (the WebGL sky did, permanently). Rounded boxes are the drawing path
     every browser gets right.
     The edges are typed properties so they can animate one by one. The
     frame inherits them and shifts back with translate, whose percentages
     (like the edges') measure the stage, since the frame is stage-sized.
     ------------------------------------------------------------------ */
  @property --edge-t { syntax: "<length-percentage>"; inherits: true; initial-value: 0px; }
  @property --edge-r { syntax: "<length-percentage>"; inherits: true; initial-value: 0px; }
  @property --edge-b { syntax: "<length-percentage>"; inherits: true; initial-value: 0px; }
  @property --edge-l { syntax: "<length-percentage>"; inherits: true; initial-value: 0px; }
  @property --edge-round { syntax: "<length-percentage>"; inherits: true; initial-value: 0px; }

  .window {
    position: absolute;
    inset: var(--edge-t) var(--edge-r) var(--edge-b) var(--edge-l);
    border-radius: var(--edge-round);
    overflow: hidden;
    transition-property: --edge-t, --edge-r, --edge-b, --edge-l, --edge-round;
  }
  .window__frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 100cqw;
    height: 100cqh;
    translate: calc(-1 * var(--edge-l)) calc(-1 * var(--edge-t));
  }

  /* ------------------------------------------------------------------
     Layers
     ------------------------------------------------------------------ */
  html:has(.stage), body:has(.stage) { height: 100%; overflow: hidden; overscroll-behavior: none; }

  .stage {
    position: fixed;
    inset: 0;
    overflow: hidden;
    container-type: size;   /* so a card window's frame can be stage-sized (100cqw x 100cqh) */
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .paper { position: absolute; inset: 0; }
  .grid {
    background-color: var(--paper);
    /* one dot at the top-left of each cell, i.e. where the old grid lines crossed */
    background-image: radial-gradient(circle at var(--grid-dot-r) var(--grid-dot-r), var(--grid-dot) calc(var(--grid-dot-r) - 0.5px), transparent var(--grid-dot-r));
    background-size: var(--grid) var(--grid);
  }

  /* The work card. At rest it's an exact copy of the left half, so it can't be seen;
     opening shrinks it down to the card while its grid zooms from 40 to 48. */
  .sheet {
    z-index: 2;
    --edge-t: var(--sheet-t);
    --edge-r: var(--sheet-r);
    --edge-b: var(--sheet-b);
    --edge-l: var(--sheet-l);
    --edge-round: var(--sheet-rad);
    transition-duration: var(--dur);
    transition-timing-function: var(--ease);
  }
  .sheet > .grid {
    background-size: var(--sheet-grid) var(--sheet-grid);
    background-position: var(--sheet-pos);
    transition: background-size var(--dur) var(--ease), background-position var(--dur) var(--ease);
  }

  /* Hover zones are the open cards' footprints, from the same numbers as the shapes. */
  .zone { position: absolute; pointer-events: none; visibility: hidden; }
  .zone--work { inset: var(--work-t) var(--work-r) var(--work-b) var(--work-l); }
  .zone--play { inset: var(--play-t) var(--play-r) var(--play-b) var(--play-l); }

  .section--work { --section-x: var(--work-x); --section-bottom: var(--work-y); }
  .section--play { --section-x: var(--play-x); --section-bottom: var(--play-y); }
  .hcard--about { --hcard-color: var(--about-color); }
  .hcard--role  { --hcard-color: var(--role-color); }

  /* While one header card is open, the other label steps back (fully, on narrow screens). */
  .stage[data-state="about"] .hcard--role .hcard__label,
  .stage[data-state="role"] .hcard--about .hcard__label { opacity: var(--opposite-label); }

  /* ------------------------------------------------------------------
     Intro (first visit per session). The controller moves data-intro from
     "pending" to "play" to "settle", then removes it.
     ------------------------------------------------------------------ */
  .js:not(.intro-seen) .stage[data-intro="pending"] .photo { --edge-t: 100%; }
  .js:not(.intro-seen) .stage[data-intro="pending"] [data-intro-line] { translate: 0 110%; }
  .js:not(.intro-seen) .stage[data-intro="pending"] .paper { opacity: 0; }

  /* Hover wakes up while the text is still settling, so the controller moves data-intro from
     "play" to "settle" at that point. That drops the paper and photo animations (both finished
     by then): while an edge animation is still attached to the photo, even a finished one, the
     browser skips the photo's own edge transitions and the sky card snaps open. */
  .stage[data-intro="play"] .paper { animation: intro-fade 0.9s linear both; }
  .stage[data-intro="play"] .photo { animation: intro-photo 1.3s var(--ease-open) 0.1s both; }
  .stage:is([data-intro="play"], [data-intro="settle"]) .photo__intro { animation: intro-zoom 1.7s var(--ease-open) 0.1s both; }
  .stage:is([data-intro="play"], [data-intro="settle"]) [data-intro-line] {
    animation: intro-line 1.1s var(--ease-text) calc(0.45s + var(--intro-i, 0) * 0.07s) both;
  }
  .hcard--about [data-intro-line] { --intro-i: 0; }
  .hcard--role  [data-intro-line] { --intro-i: 1; }
  .section--work .section__eyebrow { --intro-i: 2; }
  .section--work .section__title   { --intro-i: 3; }
  .section--play .section__eyebrow { --intro-i: 3; }
  .section--play .section__title   { --intro-i: 4; }

  @keyframes intro-fade  { from { opacity: 0; } }
  @keyframes intro-photo { from { --edge-t: 100%; } }
  @keyframes intro-zoom  { from { scale: 1.12; } }
  @keyframes intro-line  { from { translate: 0 110%; } }
</style>
