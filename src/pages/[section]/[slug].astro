---
/**
 * A single work sample or side project, rendered from its markdown file.
 * Projects with a designed case study (see `caseStudies`) get their own component on the case
 * study layout; the rest show their markdown on the placeholder page.
 */
import { getCollection, render } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import CaseStudyLayout from '~/layouts/CaseStudyLayout.astro';
import PlatformRedesign from '~/components/work/PlatformRedesign.astro';
import AiAgent from '~/components/work/AiAgent.astro';
import { site, type SectionKey } from '~/data/site';

/** Designed case studies, keyed by `section/slug`. */
const caseStudies: Partial<Record<string, typeof PlatformRedesign>> = {
  'work/platform-redesign': PlatformRedesign,
  'work/ai-agent': AiAgent,
};

export async function getStaticPaths() {
  const sections = Object.keys(site.sections) as SectionKey[];
  const paths = await Promise.all(
    sections.map(async (section) => {
      // Projects with a `url` link out to another site, so they don't get a page here.
      const items = (await getCollection(section, ({ data }) => !data.url && (import.meta.env.DEV || !data.draft)))
        .sort((a, b) => a.data.order - b.data.order);
      return items.map((entry, i) => {
        // The next project in the list (wrapping round), linked top right on case studies.
        const after = items[(i + 1) % items.length];
        const next = after.id === entry.id ? undefined : { title: after.data.title, href: `/${section}/${after.id}` };
        return { params: { section, slug: entry.id }, props: { section, entry, next } };
      });
    }),
  );
  return paths.flat();
}

const { section, entry, next } = Astro.props;
const CaseStudy = caseStudies[`${section}/${entry.id}`];
const { Content } = CaseStudy ? { Content: null } : await render(entry);
---

{CaseStudy ? (
  <CaseStudyLayout title={entry.data.title} description={entry.data.summary} next={next}>
    <CaseStudy />
  </CaseStudyLayout>
) : (
  <PageLayout title={entry.data.title} description={entry.data.summary}>
    <a class="back" href="/">← Home</a>
    <h1 class="title">{entry.data.title}</h1>
    <p class="tag"><em>{entry.data.tag}</em></p>
    <div class="prose">
      {Content && <Content />}
    </div>
  </PageLayout>
)}

<style>
  .back { font-size: clamp(13px, 1.2vw, 16px); color: var(--ink-soft); transition: color 0.2s linear; }
  .back:hover { color: var(--ink); }
  .title {
    margin: 0.4em 0 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(56px, 6.25vw, 96px);
    line-height: 1.05;
  }
  .tag { margin: 0.2em 0 0; font-size: clamp(22px, 2vw, 28px); }
  .prose { margin-top: clamp(40px, 8vh, 80px); max-width: 62ch; font-size: 16px; line-height: 1.6; }
</style>
