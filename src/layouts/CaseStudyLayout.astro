---
/**
 * Layout for a designed case study (Figma "Nav & Platform Redesign", 14:384): the dot grid paper,
 * a row with "← Home" and the next project, then one card that holds the whole story.
 * Inside the card, every block is laid out on a 1080px column (see --cs-col).
 */
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  /** The next project in the work list, linked top right. */
  next?: { title: string; href: string };
}

const { title, description, next } = Astro.props;
---

<BaseLayout title={title} description={description} htmlClass="case-study">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;600&display=swap" />
  </Fragment>

  <div class="cs paper-grid">
    <nav class="cs__nav" aria-label="Projects">
      <a class="cs__link" href="/">← Home</a>
      {next && <a class="cs__link" href={next.href}>{next.title} →</a>}
    </nav>
    <main class="cs__card">
      <slot />
    </main>
  </div>
</BaseLayout>

<style>
  .cs {
    --cs-col: 1080px;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(24px, 4vw, 48px);
    padding: clamp(20px, 4vw, 48px) clamp(12px, 3.2vw, 40px);
  }

  .cs__nav {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    font-size: clamp(14px, 1.4vw, 18px);
  }
  .cs__link { position: relative; }
  .cs__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.2em;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.35s var(--ease-text);
  }
  .cs__link:hover::after { transform: scaleX(1); transform-origin: left center; }

  .cs__card {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(48px, 5.6vw, 72px);
    padding: 32px clamp(16px, 2.5vw, 32px) clamp(16px, 2.5vw, 32px);
    background: var(--paper);
    border: 1px solid var(--cs-accent-bg);
    border-radius: var(--cs-radius);
    color: var(--cs-text);
    font-family: var(--sans);
  }
  .cs__card > :global(*) { width: 100%; max-width: var(--cs-col); }
</style>

<style is:global>
  /* Arriving on a case study cuts straight to it. The site-wide cross-fade (base.css) keeps the
     old page up underneath, and here that let home's sky, headings and corner labels show
     through the new page mid-fade, which read as a flash. The transition is styled by the page
     being opened, so this only applies on the way into a case study. */
  .case-study::view-transition-old(*) { animation: none; opacity: 0; }
  .case-study::view-transition-new(*) { animation: none; }
  .case-study::view-transition-group(*) { animation: none; }
</style>
