---
/** The case study's opening: its title in the serif, and a one-paragraph lede under it. */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="intro">
  <h1 class="intro__title">{title}</h1>
  <p class="intro__lede"><slot /></p>
</header>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }
  .intro__title {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(44px, 6.25vw, 80px);
    line-height: 1.1;
    text-wrap: balance;
  }
  /* Same size as the section copy (CaseSection.astro), 18px when that stacks. */
  .intro__lede {
    margin: 0;
    max-width: 760px;
    font-size: 20px;
    line-height: 1.5;
    text-wrap: pretty;
  }
  @media (max-width: 860px) {
    .intro__lede { font-size: 18px; }
  }
</style>
