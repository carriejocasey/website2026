---
/**
 * The sky photo, seen through a window: the right half at rest, a rounded card for play,
 * and full bleed (hidden behind the paper card) for work. The window's shape per state is in
 * HomeStage.astro; "Card windows" there explains how it stays put while the window moves.
 */
import { Image } from 'astro:assets';
import sky from '~/assets/sky.jpg';
---

<div class="photo window" aria-hidden="true">
  <div class="window__frame">
    <div class="photo__move">
      <div class="photo__intro">
        <Image
          class="photo__img"
          src={sky}
          alt=""
          widths={[1280, 1680, 2016]}
          sizes="(max-aspect-ratio: 4/5) 300vw, 110vw"
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </div>
</div>

<style>
  .photo {
    z-index: 1;
    background: var(--sky-base);
    --edge-t: var(--photo-t);
    --edge-r: var(--photo-r);
    --edge-b: var(--photo-b);
    --edge-l: var(--photo-l);
    --edge-round: var(--photo-rad);
    transition-duration: var(--photo-dur);
    transition-timing-function: var(--ease);
    transition-delay: var(--photo-delay);
  }

  /* 1353 x 1015 in Figma, never smaller than the stage (with room for the per-state nudges). */
  .photo__move {
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(calc(var(--u) * 1353), 106vw, calc((100dvh + var(--u) * 120) * 4 / 3));
    aspect-ratio: 4 / 3;
    transform: translate(-50%, -50%);
    translate: var(--photo-nudge, 0 0);
    transition: translate var(--dur) var(--ease);
  }

  .photo__intro { position: absolute; inset: 0; }

  .photo__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Portrait: anchor the photo bottom-right so the tree stays in frame. */
  @media (max-aspect-ratio: 4/5) {
    .photo__move {
      left: auto;
      top: auto;
      right: -3%;
      bottom: -3%;
      width: max(calc((100dvh * 1.06) * 4 / 3), 106vw);
      transform: none;
    }
  }
</style>
