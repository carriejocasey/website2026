---
/**
 * A lavender figure card with a mono caption underneath ("FIG. 01 · ...").
 * Put the artwork in the slot; wrap screenshots in `.frame` (white, lilac edge) for the inner card.
 */
interface Props {
  caption: string;
  class?: string;
}

const { caption, class: className } = Astro.props;
---

<figure class:list={['figure', className]}>
  <slot />
  <figcaption class="figure__caption">{caption}</figcaption>
</figure>

<style>
  .figure {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 16px;
    background: var(--cs-accent-bg);
    border-radius: var(--cs-radius);
    min-width: 0;
  }
  .figure__caption {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--cs-text-soft);
  }
  :where(.figure) :global(.frame) {
    position: relative;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--cs-accent-edge);
    border-radius: var(--cs-radius-frame);
  }
</style>
